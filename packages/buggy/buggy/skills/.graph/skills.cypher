SET n.aatmf_tactic_raw = [], n.allowed_tools = [], n.assessment_contract_json = null, n.body = '# Chain: IDOR to Privilege Escalation\n\n## Canonical path\n1. IDOR modifies another user\'s sensitive object.\n2. Escalate role/permissions or steal recovery token.\n3. Perform admin-level action and show impact.\n\n## Validation\nDemonstrate before/after authorization state and downstream privileged action evidence.\n', n.built_at = '1970-01-01T00:00:00+00:00', n.commit_sha = '', n.content_sha256 = 'sha256:f18535c463c58b663486790ef2c7ea867bbecc188149a14eb229ba56ffedddea', n.description = 'Build chains where IDOR enables privilege escalation and high-impact control-plane actions.', n.mitre_attack_raw = [], n.path = '/skills/standard/analyst/chains/idor-to-priv-esc/SKILL.md', n.size_bytes = 311, n.subdomain = 'web-exploitation', n.tags_raw = [], n.upstream_ref_raw = '', n.when_to_use = 'idor chain privilege escalation control plane high impact horizontal vertical authorization bypass';
MERGE (n:Skill {name: 'chain-ssrf-to-rce'})
SET n.aatmf_tactic_raw = [], n.allowed_tools = [], n.assessment_contract_json = null, n.body = '# Chain: SSRF to RCE\n\n## Canonical path\n1. SSRF reaches metadata/internal control plane.\n2. Extract credential/token or access internal admin API.\n3. Use credential to deploy or execute payload.\n4. Confirm code execution and business impact.\n\n## Graph guidance\n- Add `enables` edges for each pivot.\n- Lower weights for direct pivots; higher for speculative pivots.\n- Run `plan_attack_chains` and then `suggest_objectives_from_chains`.\n', n.built_at = '1970-01-01T00:00:00+00:00', n.commit_sha = '', n.content_sha256 = 'sha256:f78536faa049f67ca629eac93cb98fe9489a9809c1f48e84a74b58f46fa037ed', n.description = 'Build and validate SSRF pivot chains toward metadata/infra control and final code execution impact.', n.mitre_attack_raw = [], n.path = '/skills/standard/analyst/chains/ssrf-to-rce/SKILL.md', n.size_bytes = 435, n.subdomain = 'web-exploitation', n.tags_raw = [], n.upstream_ref_raw = '', n.when_to_use = 'ssrf chain rce remote code execution pivot cloud metadata imds iam role gopher dns rebinding';
