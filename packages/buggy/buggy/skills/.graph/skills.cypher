SET n.aatmf_tactic_raw = [], n.allowed_tools = [], n.assessment_contract_json = null, n.body = '# Chain: XSS to Takeover\n\n## Canonical path\n1. Confirm script execution in victim context.\n2. Steal session/CSRF token or trigger privileged action.\n3. Use stolen material to access victim/admin account.\n4. Demonstrate durable account impact.\n\n## Validation\nInclude both browser-side evidence and server-side action confirmation.\n', n.built_at = '1970-01-01T00:00:00+00:00', n.commit_sha = '', n.content_sha256 = 'sha256:d83a9762debb50e8841e11fcabb041659cd75029ac634badecf1325e750c6601', n.description = 'Build chains from XSS into account takeover or privileged action execution.', n.mitre_attack_raw = [], n.path = '/skills/standard/analyst/chains/xss-to-takeover/SKILL.md', n.size_bytes = 330, n.subdomain = 'web-exploitation', n.tags_raw = [], n.upstream_ref_raw = '', n.when_to_use = 'xss chain account takeover privileged action cookie session csrf token theft post-message';
